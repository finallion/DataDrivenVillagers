  "authors": [
    "Lion"
  ],
  "contact": {},

  "license": "GPL-3.0-only",
  "icon": "assets/datadrivenvillagers/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lion.datadrivenvillagers.fabric.DataDrivenVillagersFabric"
    ],
    "client": [
      "com.lion.datadrivenvillagers.fabric.DataDrivenVillagersFabricClient"
    ]
  },
  "mixins": [
    "datadrivenvillagers-common.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": ">=1.21.8 <1.21.9",
    "java": ">=21"
  },
  "recommends": {
    "villagertradingplus": ">=1.0.0"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://www.patreon.com/cw/LithiumPlus"
      }
